"CREATE TABLE users(id TEXT PRIMARY KEY,email TEXT UNIQUE,name TEXT NOT NULL,role TEXT NOT NULL);\n--> statement-breakpoint\n--> statement-breakpoint\nCREATE TABLE subjects(id TEXT PRIMARY KEY,title TEXT,description TEXT,theme TEXT,cover TEXT,visible INTEGER,pos INTEGER,version INTEGER DEFAULT 1);\n--> statement-breakpoint\n--> statement-breakpoint\n--> statement-breakpoint\nCREATE TABLE tasks(id TEXT PRIMARY KEY,sid TEXT REFERENCES subjects(id),body TEXT,published INTEGER,pos INTEGER,version INTEGER DEFAULT 1);\n--> statement-breakpoint\nCREATE TABLE files(id TEXT PRIMARY KEY,sid TEXT REFERENCES subjects(id),name TEXT,type TEXT,size INTEGER);\n--> statement-breakpoint\nCREATE TABLE quizzes(id TEXT PRIMARY KEY,sid TEXT REFERENCES subjects(id),author TEXT REFERENCES users(id),body TEXT,version INTEGER DEFAULT 1);\n--> statement-breakpoint\nCREATE TABLE shares(qid TEXT REFERENCES quizzes(id),sid TEXT REFERENCES subjects(id),PRIMARY KEY(qid,sid));\n--> statement-breakpoint\nCREATE TABLE runs(id TEXT PRIMARY KEY,pin TEXT,owner TEXT REFERENCES users(id),sid TEXT REFERENCES subjects(id),qid TEXT REFERENCES quizzes(id),task TEXT,request TEXT,body TEXT,phase TEXT,idx INTEGER,deadline INTEGER,remaining INTEGER,version INTEGER,started INTEGER,ended INTEGER,early INTEGER DEFAULT 0,UNIQUE(owner,request));\n--> statement-breakpoint\nCREATE UNIQUE INDEX active_pin ON runs(pin) WHERE ended IS NULL;\n--> statement-breakpoint\nCREATE TABLE players(id TEXT PRIMARY KEY,run TEXT REFERENCES runs(id),name TEXT,normalized TEXT,token TEXT UNIQUE,joined INTEGER,UNIQUE(run,normalized));\n--> statement-breakpoint\nCREATE TABLE answers(player TEXT REFERENCES players(id),idx INTEGER,value TEXT,points INTEGER,at INTEGER,PRIMARY KEY(player,idx));\n--> statement-breakpoint\n--> statement-breakpoint\nALTER TABLE runs ADD COLUMN volume REAL NOT NULL DEFAULT 1;\n--> statement-breakpoint\nCREATE TABLE migrations(name TEXT PRIMARY KEY);\n--> statement-breakpoint\nCREATE TABLE revision(id INTEGER PRIMARY KEY,v INTEGER NOT NULL CHECK(v>=0));\n\nCREATE TABLE player_avatars(player TEXT PRIMARY KEY REFERENCES players(id), avatar TEXT NOT NULL);\n\nCREATE TABLE areas(id TEXT PRIMARY KEY, sid TEXT NOT NULL REFERENCES subjects(id), title TEXT NOT NULL, icon TEXT NOT NULL, pos INTEGER NOT NULL, version INTEGER NOT NULL DEFAULT 1);\n--> statement-breakpoint\nCREATE TABLE task_areas(task TEXT PRIMARY KEY REFERENCES tasks(id), area TEXT NOT NULL REFERENCES areas(id), created_order INTEGER NOT NULL UNIQUE);\n--> statement-breakpoint\nCREATE TABLE subject_icons(sid TEXT PRIMARY KEY REFERENCES subjects(id), icon TEXT NOT NULL);\n--> statement-breakpoint\nCREATE INDEX tasks_by_area ON task_areas(area,created_order);\n\nCREATE TABLE feedback_forms(id TEXT PRIMARY KEY, sid TEXT NOT NULL REFERENCES subjects(id), owner TEXT NOT NULL REFERENCES users(id), title TEXT NOT NULL, questions TEXT NOT NULL, status TEXT NOT NULL DEFAULT 'draft', share TEXT NOT NULL UNIQUE, responses INTEGER NOT NULL DEFAULT 0, version INTEGER NOT NULL DEFAULT 1, created INTEGER NOT NULL);\n--> statement-breakpoint\nCREATE TABLE feedback_counts(form TEXT NOT NULL REFERENCES feedback_forms(id), question TEXT NOT NULL, answer TEXT NOT NULL, n INTEGER NOT NULL, PRIMARY KEY(form,question,answer));\n--> statement-breakpoint\nCREATE TABLE feedback_receipts(form TEXT NOT NULL REFERENCES feedback_forms(id), digest TEXT NOT NULL, PRIMARY KEY(form,digest));\n\nCREATE TABLE removed_subjects(id TEXT PRIMARY KEY REFERENCES subjects(id));\n--> statement-breakpoint\nCREATE TABLE removed_run_sources(run TEXT PRIMARY KEY REFERENCES runs(id));\n\nCREATE TABLE retention_policy(id INTEGER PRIMARY KEY, games INTEGER, comments INTEGER, version INTEGER NOT NULL);\n--> statement-breakpoint\nALTER TABLE feedback_forms ADD COLUMN closed_at INTEGER;\n--> statement-breakpoint\nALTER TABLE feedback_forms ADD COLUMN comments_removed INTEGER NOT NULL DEFAULT 0;\n--> statement-breakpoint\nUPDATE feedback_forms SET closed_at=CAST(strftime('%s','now') AS INTEGER)*1000 WHERE status='closed';\n"